# Copy this file to .env; keep actual credentials local.
DASHSCOPE_API_KEY=your_dashscope_key
OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
VISION_MODEL=qwen-vl-plus
LOGIC_MODEL=qwen-long

AI_REQUEST_TIMEOUT_SECONDS=90
AI_MAX_RETRIES=2
RAG_MAX_CONCURRENCY=3

# Backend service root used by the teacher workspace (without /api).
HOMEWORK_API_BASE_URL=http://localhost:8000
# Task files are local data; no built-in sample tasks are loaded.
HOMEWORK_TASKS_PATH=output/tasks.json

# Relative paths are resolved from the project root.
CHROMA_DB_PATH=chroma_db
# After a verified rebuild, use output/course-knowledge-base instead.
CHROMA_COLLECTION=langchain
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
# Normal queries use the cached model. Set false only for intentional first-time download.
EMBEDDING_LOCAL_FILES_ONLY=true
